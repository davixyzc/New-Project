// Array get/set, property set, globals, remainder and copies, run in loops so the JIT's fast paths and their
// fallbacks both run.
const arr = [1, 2, 3];
let acc = 0;
for (let i = -1; i < 5; i++) {
  const v = arr[i];
  acc = acc + (v === undefined ? 100 : v);
}
console.log(acc);
for (let i = 0; i < 4; i++) arr[i] = i * 10;
console.log(arr.join(","), arr.length);
const frac = [5, 6];
console.log(frac[0.5], frac[1.0], frac[-0], frac[2]);
const objs = { a: 1 };
for (let i = 0; i < 3; i++) { objs.a = objs.a + i; objs.b = i; }
console.log(objs.a, objs.b);
let caught = "";
for (let i = 0; i < 2; i++) {
  try { const s = null; s.x = 1; } catch (e) { caught = caught + e.name; }
}
console.log(caught);
let g = 0;
for (let i = 0; i < 2; i++) {
  try { g += missingGlobal; } catch (e) { g += 1; }
}
console.log(g);
let m = 0;
for (let i = 0; i < 1000; i++) m += Math.floor(i / 3) + Math.max(i, 2);
console.log(m);
let md = 0;
for (let i = 0; i < 20; i++) md += (i * 1.5) % 4 + (i % "3") + (-i) % 5;
console.log(md);
let texts = "";
for (let i = 0; i < 4; i++) { const t = "s" + i; texts = texts + t + (i % 2 === 0 ? "e" : "o"); }
console.log(texts);
const grid = [[1, 2], [3, 4]];
for (let r = 0; r < 2; r++) for (let c = 0; c < 2; c++) grid[r][c] = grid[r][c] * 2 + r;
console.log(JSON.stringify(grid));
const holder = [0, 0];
for (let i = 0; i < 2; i++) holder[i] = [i, i + 1];
console.log(JSON.stringify(holder));
const src = [[7], [8]];
const got = src[0];
src[0] = 5;
console.log(got[0], src[0]);
let shared = { n: 0 };
const alias = shared;
for (let i = 0; i < 3; i++) { alias.n += 2; shared = alias; }
console.log(shared.n, alias === shared);
