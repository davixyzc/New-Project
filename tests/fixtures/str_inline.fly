// Strings on both sides of the inline limit, which is 15 bytes: grown in place and from shared text, cut into pieces,
// read by index in the JIT and in the interpreter, and compared, hashed and sorted, checked against Node.
const ALPHA = "abcdefghijklmnopqrstuvwxyz";
function codeAt(s, i) { return s.charCodeAt(i); }
function sumCodes(s) {
  let total = 0;
  for (let i = 0; i < s.length; i++) total += codeAt(s, i);
  return total;
}
// A string grown in place, one character at a time, past the inline limit.
{
  let s = "";
  for (let n = 0; n <= 40; n++) {
    console.log(n, s.length, sumCodes(s), s);
    s = s + ALPHA[n % 26];
  }
}
// Hot reads of short and long strings, so that the JIT compiles the reads of both.
{
  const short = "0123456789abcd";
  const long = short + "efghijklmnopqrstuvwxyz";
  let total = 0;
  for (let round = 0; round < 3000; round++) total += sumCodes(short) + sumCodes(long);
  console.log("hot", total);
}
// Shared text extended by concatenation: the copy ends inline at 15 bytes and on the heap at 16.
{
  const pre = "0123456789abcd";
  for (const tail of ["", "x", "xy", "xyz", "xyzw"]) {
    const t = pre + tail;
    console.log("shared", t.length, t.charCodeAt(0), t.charCodeAt(t.length - 1), t);
  }
}
// Pieces of a string built in place: the short pieces are inline and the long one is on the heap.
{
  let s = "";
  for (let i = 0; i < 4; i++) s = s + "ab-";
  s = s + "0123456789abcdefghijklmnopqrstuvwxyz" + "-end";
  const parts = s.split("-");
  for (const p of parts) console.log("piece", p.length, p.charCodeAt(0), p);
  console.log("joined", parts.join("+").length, parts.join("+"));
}
// Equal strings built in different ways are the same key and compare equal.
{
  const k1 = "ab" + "cdefghijklmnopqrstuvwxyz0123";
  const k2 = "abcdefghijklmnopqrstuvwxyz0123";
  const m = new Map();
  m.set(k1, "found");
  console.log("equal", k1 === k2, m.get(k2), new Set(["a" + "b", "ab"]).size);
  console.log("order", "abc" < "abd", "ab" < "abc", "a" + "z" > "a" + "y");
}
// Non-ASCII text: lengths and indexes count characters, while the limit counts bytes.
{
  let w = "ç";
  for (let n = 0; n < 12; n++) w = w + "é";
  console.log("accent", w.length, w.charCodeAt(0), w.charCodeAt(11), w.slice(9));
}
// Slices, case changes and trimming of short and long text.
{
  const long = "0123456789abcdefghijklmnopqrstuvwxyz";
  console.log("slice", long.slice(20, 25), long.substring(30), long.toUpperCase().slice(0, 4));
  console.log("trim", ("   " + "padded" + "   ").trim(), "x".toUpperCase());
}
// Strings sort by their text, whatever their length.
{
  const words = ["abcdefghijklmnopqrstuvwxyz1", "b", "abcdefghijklmnopqrstuvwxyz", "a" + "c", "aa" + ""];
  words.sort();
  console.log("sorted", words.join(" "));
}
