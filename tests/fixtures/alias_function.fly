// A numeric function whose operands wait in registers across its comparisons and operators, called from a loop.
function mix(x, y) {
  const d = x - y;
  return x * (y < 2 ? 3 : 4) - (x + y) / (d === 0 ? 1 : d) + (y <= x ? 0.5 : -0.5);
}
let sum = 0;
for (let i = 0; i < 40; i++) sum += mix(i * 0.5, 1.5 + (i % 4));
console.log(sum.toFixed(6));
