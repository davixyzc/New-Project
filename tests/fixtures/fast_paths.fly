// Covers the fused instructions, per-variable cells, in-place appends and loop layouts.

// --- compound assignment and evaluation order
function order() {
  let x = 1;
  x += (x = 5);            // old x (1) + 5
  let y = 1;
  y = y + (y = 2);         // old y (1) + 2
  let s = "a";
  s += 1;
  s = s + "-" + 2;
  let n = 10;
  n -= 3;
  n *= 2;
  return [x, y, s, n];
}
console.log(JSON.stringify(order()));

// --- fused local/constant operators with mixed operand types
function mixed(text, num) {
  let t = text;
  let v = num;
  return [t + 1, t - 1, t * 2, t % 3, v + 1, v % 3, -7 % 3, 7.5 % 2, v * 2];
}
console.log(JSON.stringify(mixed("5", 4)), JSON.stringify(mixed("10", 3)));
console.log(JSON.stringify(mixed(undefined, 1)));

// --- comparisons on locals, strings and NaN
function compare(a, b) {
  let r = [];
  if (a < b) r.push("lt");
  if (a < 2) r.push("lt2");
  return r;
}
console.log(JSON.stringify([compare(1, 2), compare("10", "9"), compare("1", 2), compare(NaN, 1), compare("b", "a")]));

// --- loops: test at the bottom, continue, break, do-while, for without test
let total = 0;
for (let i = 0; i < 10; i++) {
  if (i === 2) continue;
  if (i === 7) break;
  total += i;
}
console.log("for", total);

let w = 0;
let steps = 0;
while (w < 5) {
  w++;
  if (w % 2 === 0) continue;
  steps++;
}
console.log("while", w, steps);

let d = 0;
do {
  d += 3;
  if (d === 6) continue;
} while (d < 10);
console.log("do", d);

let forever = 0;
for (;;) {
  forever++;
  if (forever > 4) break;
}
console.log("forever", forever);

function bounded(limit) {
  let k = 0;
  let hits = 0;
  while (k < limit) {
    k++;
    hits++;
  }
  for (let j = 0; j < limit; j++) hits++;
  return hits;
}
console.log("bounded", bounded(3), bounded(0));

// --- per-iteration closures over loop variables and block lets
const fns = [];
for (let i = 0; i < 3; i++) {
  const sq = i * i;
  fns.push(() => i + sq);
}
console.log(JSON.stringify(fns.map((f) => f())));

const pairs = [];
for (const name of ["ann", "ben"]) {
  pairs.push(() => name.toUpperCase());
}
console.log(pairs[0](), pairs[1]());

// --- cells only where captured; a reused slot must not leak a cell
function stale() {
  let keep;
  {
    let a = 10;
    keep = () => a;
  }
  {
    let b = 20;
    console.log("b", b);
  }
  return keep();
}
console.log("stale", stale());

// --- captured parameter and nested closures
function counterFrom(start) {
  let count = start;
  return {
    inc: (by) => {
      count += by;
      return () => count;
    },
  };
}
const ctr = counterFrom(5);
const read = ctr.inc(2);
ctr.inc(10);
console.log("counter", read());

// --- methods on locals, strings and arrays
function methods() {
  const obj = { n: 4, twice() { return this.n * 2; } };
  const s = "abc";
  const list = [3, 1, 2];
  list.push(9);
  return [obj.twice(), s.toUpperCase(), s.length, list.length, list.sort().join("|")];
}
console.log(JSON.stringify(methods()));

// --- in-place string building in a loop
let built = "";
for (let i = 0; i < 1000; i++) {
  built = built + "x";
  built += i % 10;
}
console.log("built", built.length, built.slice(0, 6));

// --- array callbacks, including arguments and early exits
const data = [5, 3, 8, 1];
console.log(JSON.stringify(data.map((x, i) => x + i)), JSON.stringify(data.filter((x) => x > 2)), data.reduce((a, b) => a + b));
console.log(data.find((x) => x > 4), data.findIndex((x) => x === 8), data.some((x) => x > 7), data.every((x) => x > 0));
console.log(JSON.stringify(data.slice().sort((a, b) => b - a)), JSON.stringify([10, 9, 1].sort()));
try {
  [].reduce((a, b) => a + b);
} catch (e) {
  console.log(e.name);
}

// --- property reads on locals that are not objects
function reads() {
  const o = { a: 1, a2: 2 };
  let u;
  let out = [o.a, o.missing, o.a2 + 1];
  try {
    out.push(u.x);
  } catch (e) {
    out.push(e.name);
  }
  return out;
}
console.log(JSON.stringify(reads()));
