// The same remainders by divisors that are not literals, in a function that takes an array, so that it runs as VM code.
function remainders(xs, d, out) {
  for (let i = 0; i < xs.length; i++) out.push(xs[i] % d);
}
const dividends = [0, 1, 2147483647, 2147483648, 3000000000, 4294967296, 9007199254740991, 9007199254740992,
  9007199254740993, 2 ** 62, 2 ** 63 - 1024, 2 ** 63, 1e18, -5, -2147483649, -0, 0.5, NaN, Infinity, -Infinity];
for (const d of [0, 1, 2, 3, 10, 97, -3, 1000000007, 2147483647, 2147483648]) {
  const out = [];
  remainders(dividends, d, out);
  console.log(d, out.join(' '));
}
