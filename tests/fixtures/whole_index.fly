// Whole numbers index arrays and take remainders inside loops. A value that stops being whole, that overflows, or that
// is NaN must take the path JavaScript takes, both where it is read as an index and where it is a dividend.
const arr = [];
for (let i = 0; i < 300; i++) arr.push((i * 3) % 17);

// A counter that stays whole indexes two arrays.
let s = 0;
for (let i = 0; i < 2000; i++) s += arr[i % 300] + arr[(i * 7) % 300];
console.log(s);

// A counter that becomes a fraction reads undefined through its indexes.
let f = 0;
let missing = 0;
for (let i = 0; i < 40; i++) {
  f += 0.5;
  if (arr[f] === undefined) missing++;
}
console.log(f, missing);

// Remainders of whole dividends across the 32-bit range, of both signs.
let acc = 0;
for (let i = 0; i < 3000; i++) {
  const v = ((i * 1000003) % 4294967296) - 2147483648;
  acc += (v % 120) + (v % 7);
}
console.log(acc);

// Dividends beyond the 32-bit range take the slow path.
let acc2 = 0;
for (let i = 0; i < 3000; i++) {
  const w = (i - 1500) * 2000000;
  acc2 += w % 120;
}
console.log(acc2);

// Negative zero keeps its sign through the remainder.
let negZeros = 0;
for (let i = 0; i < 3000; i++) {
  const z = (i - i) * -1;
  if (1 / (z % 120) < 0) negZeros++;
}
console.log(negZeros);

// A product that overflows to Infinity, which has no remainder and no index.
let p = 1;
let found = 0;
for (let i = 0; i < 1000; i++) {
  p *= 3;
  if (arr[p % 300] !== undefined) found++;
}
console.log(p, found);

// Keys that are NaN, negative, or far past the array read undefined.
let odd = 0;
for (let i = 0; i < 2000; i++) {
  const key = i % 4 === 0 ? 0 / 0 : i % 4 === 1 ? -1 : i % 4 === 2 ? 1e10 : i;
  if (arr[key] === undefined) odd++;
}
console.log(odd);

// A value read from before the loop that is a fraction is checked on entry.
let start = 2.5;
let sum = 0;
for (let i = 0; i < 2000; i++) sum += arr[(i + start) % 300] || 0;
console.log(sum);

// A whole start takes the whole path from the first iteration.
let g = 3;
let gs = 0;
for (let i = 0; i < 2000; i++) {
  g = (g * 5 + 1) % 97;
  gs += arr[g] + g;
}
console.log(g, gs);

// A boolean stored into an array inside the loop, with whole counters around it.
const flags = [];
for (let i = 0; i < 400; i++) flags.push(false);
let w = 0;
for (let i = 0; i < 2000; i++) {
  flags[i % 400] = i % 3 === 0;
  w += flags[(i * 7) % 400] ? 2 : 1;
}
console.log(w);

// A local that is a whole number, then a fraction, then whole again.
let t = 0;
let u = 0;
for (let i = 0; i < 1500; i++) {
  u = i % 5 === 0 ? u + 0.5 : u + 1;
  t += arr[u * 2] === undefined ? 0 : 1;
}
console.log(u, t);

// A whole counter past the 32-bit range, in a loop that runs again, takes the generic path for its remainders.
let big = 3000000000;
let bigSum = 0;
for (let r = 0; r < 3; r++) {
  for (let i = 0; i < 100; i++) bigSum += (big + i) % 7;
  big += 1000000007;
}
console.log(bigSum, big);
