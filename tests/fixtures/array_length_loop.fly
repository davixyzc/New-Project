// The length of an array, a string or an object is read in a loop header, where the loop does not index the value. An
// array is read in place, and anything else, or an array that changes type between rounds, runs the generic code.
const xs = [1, 2, 3];
let total = 0;
for (let k = 0; k < 4; k++) {
  for (let j = 0; j < xs.length; j++) total += k;
}
console.log(total);

const word = "abcd";
let n = 0;
for (let k = 0; k < 3; k++) for (let j = 0; j < word.length; j++) n++;
console.log(n);

const box = { length: 2 };
let m = 0;
for (let k = 0; k < 3; k++) for (let j = 0; j < box.length; j++) m++;
console.log(m);

let v = [1, 2, 3];
let c = 0;
for (let k = 0; k < 5; k++) {
  for (let j = 0; j < v.length; j++) c++;
  if (k === 1) v = "xy";
}
console.log(c);
