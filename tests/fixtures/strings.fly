const s = "Hello, World";
console.log(s.length, s.toUpperCase(), s.toLowerCase(), s.indexOf("World"), s.indexOf("nope"));
console.log(s.slice(0, 5), s.slice(-5), s.substring(7), s.charAt(4), s[1], s.charCodeAt(0));
console.log(s.includes("lo, W"), s.startsWith("Hell"), s.endsWith("ld"), s.split(", "));
