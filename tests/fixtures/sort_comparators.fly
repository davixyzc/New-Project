// Sorting with comparators of several shapes: numeric ones may run without the interpreter, others must not.
const nums = [5, -1, 3, 3, 0, -0, 12, -7.5, 100, 2];
console.log(nums.slice().sort((a, b) => a - b).join(" "));
console.log(nums.slice().sort((a, b) => b - a).join(" "));
console.log(nums.slice().sort((a, b) => (a > b) - (a < b)).join(" "));
console.log(nums.slice().sort((a, b) => a % 7 - b % 7).join(" "));
console.log(nums.slice().sort((a, b, c) => a % 7 - b % 7).join(" "));
const mixed = [4, "10", 1, "x", 7, "2"];
console.log(mixed.slice().sort((a, b) => String(a) < String(b) ? -1 : String(a) > String(b) ? 1 : 0).join(" "));
let big = [];
for (let i = 0; i < 300; i++) big.push((i * 7919) % 1009);
big.sort((a, b) => a - b);
console.log(big[0], big[150], big[299], big.length);
