// Numeric recursion whose calls take other calls as arguments, which the native code runs with several operands
// pending. Each result is checked against the values Node gives, so a wrong save or restore of an operand shows.
function tak(x, y, z) {
  return y < x ? tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y)) : z;
}
function ack(m, n) {
  return m === 0 ? n + 1 : n === 0 ? ack(m - 1, 1) : ack(m - 1, ack(m, n - 1));
}
function fib(n) {
  return n < 2 ? n : fib(n - 1) + fib(n - 2);
}
let total = 0;
for (let i = 0; i < 40; i++) total += tak(12 + i % 5, 6, 3 + i % 3);
console.log(tak(18, 12, 6), tak(14, 8, 4), total);
console.log(ack(2, 3), ack(3, 3), ack(2, 7));
console.log(fib(20), fib(24));
