function makeCounter(step) {
  let count = 0;
  return { inc() { count += step; return count; }, read() { return count; } };
}
const c = makeCounter(3);
for (let i = 0; i < 4; i++) c.inc();
console.log(c.inc(), c.read());
const fns = [];
for (let i = 0; i < 3; i++) fns.push(() => i * 10);
console.log(fns.map(f => f()).join(","));
function classify(n) {
  switch (n % 4) {
    case 0: return "zero";
    case 1: return "one";
    case 2: { let s = "two"; return s + "!"; }
    default: return "other";
  }
}
let out = "";
for (let i = 0; i < 9; i++) out += classify(i) + ";";
console.log(out);
let visits = 0;
function search(list, target) {
  let found = -1;
  for (let i = 0; i < list.length; i++) {
    try {
      if (list[i] === target) { found = i; break; }
      if (list[i] < 0) continue;
    } finally {
      visits += 1;
    }
  }
  return found;
}
console.log(search([4, -1, 7, 9, 11], 9), search([1, 2], 5), visits);
