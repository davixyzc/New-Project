// Recursive numeric functions whose calls nest deep in their arguments, so that the operands reach the
// deepest registers of a function region.
function tak(x, y, z) {
  return y < x ? tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y)) : z;
}
function mix(n, a, b) {
  if (n <= 0) return (a * 3 + b) % 1009;
  return (mix(n - 1, (mix(n - 1, a, b) + 7) % 1009, (a - b) % 1009) * 5 + mix(n - 1, b, (a + 2) % 1009)) % 1009;
}
console.log(tak(18, 12, 6), tak(12, 6, 0), tak(9, 3, 1));
console.log(mix(4, 1, 2), mix(5, -3, 8), mix(6, 100, -7));
