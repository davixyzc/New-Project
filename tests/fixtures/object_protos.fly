console.log(Object.is(1, 1), Object.is(NaN, NaN), Object.is(0, -0), Object.is("a", "a"), Object.is({}, {}));
const base = { greet() { return "hi " + this.name; } };
const child = Object.create(base);
child.name = "ana";
console.log(child.greet(), Object.getPrototypeOf(child) === base);
const bare = Object.create(null);
bare.k = 1;
console.log(bare.k, Object.getPrototypeOf(bare));
class Pt { constructor(x) { this.x = x; } }
console.log(Object.getPrototypeOf(new Pt(2)) === Pt.prototype, new Pt(3) instanceof Pt);
