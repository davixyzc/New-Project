console.log(p, r, s);
const [[m, n], { o }] = [[1, 2], { o: "x" }];
console.log(m, n, o);
for (const [k, v] of new Map([["a", 1], ["b", 2]])) console.log("entry", k, v);
const users = [{ id: 1, name: "ann" }, { id: 2, name: "bo" }];
for (const { id, name } of users) console.log("user", id, name);
function f([u, w], { c = 5 }) {
  return u + w + c;
}
console.log(f([1, 2], {}), f([1, 1], { c: 0 }));
const g = ([k, v]) => k + v;
console.log(g(["x", "y"]));
