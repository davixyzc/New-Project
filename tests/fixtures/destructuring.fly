{
const { a, ...others } = { a: 1, b: 2, c: 3 };
console.log(a, others);
const { x: { y, ...deeper }, ...top } = { x: { y: 1, z: 2 }, w: 3 };
console.log(y, deeper, top);
function pick({ id, ...fields }) {
  return id + ":" + JSON.stringify(fields);
}
console.log(pick({ id: 7, name: "n", age: 3 }));
const row = [1, 2];
let total = 0;
function sumRows(rows) {
  let acc = 0;
  for (const [p, q] of rows) acc += p * q;
  return acc;
}
const rows = [];
for (let i = 0; i < 40; i++) rows.push([i, i + 1]);
console.log(sumRows(rows), sumRows(rows.slice(0, 3)));
function bubble(arr) {
  for (let i = 0; i < arr.length; i++)
    for (let j = 0; j + 1 < arr.length - i; j++)
      if (arr[j] > arr[j + 1]) [arr[j], arr[j + 1]] = [arr[j + 1], arr[j]];
  return arr;
}
console.log(bubble([5, 3, 9, 1, 7, 2, 8, 0]).join(" "));
try {
  const { q } = null;
  console.log("no", q);
} catch (e) {
  console.log(e.name);
}
}
