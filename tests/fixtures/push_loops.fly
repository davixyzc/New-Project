// `push` in loops: plain values written past the end (growing the array as it goes), values that hold references, an
// alias of the array, and the length that `push` returns used in an expression.
const nums = [];
let last = 0;
for (let i = 0; i < 500; i++) last = nums.push(i % 7 === 0 ? true : i);
console.log(nums.length, last, nums[0], nums[1], nums[499], nums[7]);
const mixed = [];
for (let i = 0; i < 40; i++) {
  if (i % 4 === 0) mixed.push("s" + i);
  else if (i % 4 === 1) mixed.push({ i });
  else if (i % 4 === 2) mixed.push([i]);
  else mixed.push(i % 8 === 3 ? null : undefined);
}
console.log(mixed.length, mixed[0], mixed[1].i, mixed[2][0], mixed[3], mixed[7], mixed[39]);
const alias = [];
const other = alias;
for (let i = 0; i < 300; i++) other.push(i * 2);
console.log(alias.length, alias[299], other === alias);
const full = [1, 2, 3];
for (let i = 0; i < 100; i++) full.push(i);
console.log(full.length, full[3], full[102]);
const holder = { push: (x) => x * 10 };
let fake = 0;
for (let i = 0; i < 50; i++) fake += holder.push(i);
console.log(fake);
const rows = [];
for (let r = 0; r < 60; r++) {
  const row = [];
  for (let c = 0; c < 60; c++) row.push(c % 3 === 0 ? r : c);
  rows.push(row);
}
console.log(rows.length, rows[59][59], rows[3][3], rows[0].length);
