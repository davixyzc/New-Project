function thrower(n) { if (n === 3) throw new Error("boom " + n); return n; }
function level2(n) { return thrower(n) * 2; }
function level1(n) { try { return level2(n) + 1; } catch (e) { return -1; } }
let total = 0;
for (let i = 0; i < 6; i++) total += level1(i);
console.log(total);
function r(n) { return r(n + 1); }
try { r(0); } catch (e) { console.log(e.name); }
function deep(n) { if (n === 0) return 0; return 1 + deep(n - 1); }
console.log(deep(5000));
