// Loops whose locals start as strings, undefined or booleans. The compare-and-jump and the loop registers must
// keep the values the program gives them, not numbers read from their bits.
function semNumero(a, b) {
  let s = b;
  for (let i = 0; i < 40; i++) {
    if (i < 40) continue;
    s = 1;
    if (s !== s) break;
  }
  return s;
}
console.log(semNumero(0, 5), semNumero(1, 2), semNumero(0, "5"), semNumero(0, undefined), semNumero(2, true));

function comparaTexto(a, b) {
  let s = b;
  for (let i = 0; i < 40; i++) {
    s = (-0.25 < s) ? a : -3;
  }
  return s;
}
console.log(comparaTexto(0, "5"), comparaTexto(7, "2"), comparaTexto(1, 3));

function paradaTexto(a, b) {
  let s = b;
  let i = 0;
  while (i < 40) {
    s = (-0.25 < s) ? 1 : 2;
    i++;
  }
  return s + i;
}
console.log(paradaTexto(0, "5"), paradaTexto(0, 9));

function acumulaTexto(texto) {
  let total = 0;
  for (let i = 0; i < 3; i++) {
    if (total < texto) total = total + 1;
  }
  return total;
}
console.log(acumulaTexto("10"), acumulaTexto("2"));

let contador = "3";
for (let i = 0; i < 5; i++) {
  if (i < contador) contador = "9";
}
console.log(contador);
