{
  function fazVar() {
    const fs = [];
    for (var j = 0; j < 3; j++) fs.push(() => j);
    return fs;
  }
  console.log(fazVar().map((f) => f()).join(","));
  function hoisted() {
    const before = typeof later;
    var later = 7;
    if (true) {
      var inner = "block";
    }
    return before + " " + later + " " + inner;
  }
  console.log(hoisted());
  function param(x) {
    var x;
    return x;
  }
  console.log(param(42));
  function loops() {
    var total = 0;
    for (var k in { a: 1, b: 2 }) total = total + k.length;
    for (var item of [4, 5]) total = total + item;
    var a = 1, b, c = a + 1;
    return [total, a, b, c, k, item].join(" ");
  }
  console.log(loops());
}
