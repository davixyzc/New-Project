{
class Counter {
  count = 0;
  step = 1;
  static created = 0;
  constructor(start) {
    this.count = start;
    Counter.created = Counter.created + 1;
  }
  bump() {
    this.count = this.count + this.step;
    return this;
  }
  static make(n) {
    return new this(n);
  }
}
const c = new Counter(5).bump().bump();
console.log(c.count, c.step, Counter.created);
const m = Counter.make(9);
console.log(m.count, Counter.created, m instanceof Counter);
class Named extends Counter {
  label = "named";
  constructor(start, tag) {
    super(start);
    this.tag = tag;
  }
  get total() {
    return this.count * 10;
  }
  set total(v) {
    this.count = v / 10;
  }
  bump() {
    super.bump();
    return this;
  }
}
const n = new Named(2, "t");
n.bump();
console.log(n.count, n.total, n.label, n.tag, Named.created);
n.total = 70;
console.log(n.count, n.total, Counter.make(1) instanceof Named);
const Expr = class {
  hi() {
    return "expr";
  }
};
const Anon = class Inner extends Expr {
  hi() {
    return "inner " + super.hi();
  }
};
console.log(new Expr().hi(), new Anon().hi(), Anon.name, Expr.name === "");
function build(kind) {
  class Local {
    constructor(x) {
      this.x = x;
      this.kind = kind;
    }
    get doubled() {
      return this.x * 2;
    }
  }
  return new Local(4);
}
const built = build("local");
console.log(built.x, built.kind, built.doubled, built instanceof Object);
console.log(new Map() instanceof Map, new Set() instanceof Set, new Map() instanceof Set, [] instanceof Map);
class Shape {
  area() {
    return 0;
  }
  describe() {
    return this.constructor.name + " area " + this.area();
  }
}
class Square extends Shape {
  constructor(side) {
    super();
    this.side = side;
  }
  area() {
    return this.side * this.side;
  }
}
const shapes = [new Shape(), new Square(3)];
for (const s of shapes) console.log(s.describe());
console.log("side" in new Square(2), "area" in new Square(2), "nope" in new Square(2));
class Empty {}
console.log(new Empty(), typeof Empty, new Empty() instanceof Empty);
class WithStatic {
  static greeting = "hello";
  static shout(word) {
    return WithStatic.greeting + " " + word;
  }
}
class Child extends WithStatic {}
console.log(WithStatic.shout("a"), Child.shout("b"), Child.greeting);
}
{
class Animal {
  constructor(name) {
    this.name = name;
  }
  speak() {
    return this.name + " makes a sound";
  }
  get shout() {
    return this.name.toUpperCase();
  }
  static kind() {
    return "animal";
  }
}
class Dog extends Animal {
  constructor(name, breed) {
    super(name);
    this.breed = breed;
  }
  speak() {
    return super.speak() + " (woof)";
  }
}
const a = new Animal("cat");
const d = new Dog("rex", "lab");
console.log(a.speak());
console.log(d.speak(), d.shout, Animal.kind(), Dog.kind());
console.log(d instanceof Dog, d instanceof Animal, a instanceof Dog, a instanceof Animal);
console.log(d);
console.log(a);
console.log(d.name, d.breed, Object.keys(d).join(","), JSON.stringify(d));
console.log(typeof Dog, Dog.name, d.constructor === Dog);
}
{
class A {
  constructor(n) {
    this.n = n;
  }
  get twice() {
    return this.n * 2;
  }
  set value(v) {
    this.n = v;
  }
}
const a = new A(4);
console.log(a.twice);
console.log(a.n);
a.value = 9;
console.log(a.n, a.twice);
class B extends A {}
const b = new B(5);
console.log(b.twice, b.n);
}
{
class Point {
  constructor(x, y) {
    this.x = x;
    this.y = y;
  }
  toString() {
    return "(" + this.x + ", " + this.y + ")";
  }
}
const p = new Point(1, 2);
console.log(`at ${p}`);
console.log("start " + p + " end");
console.log(String(p), [p, new Point(3, 4)].join(" | "));
class Plain {}
console.log(`${new Plain()}`, "" + [1, 2], String(null), `${undefined}`);
const q = new Point(5, 6);
q.toString = () => "custom";
console.log(`${q}`, `${p}`);
console.log(p, [p]);
}
