// A loop reads two properties of an object, while a method deletes a property and adds it back, which moves the values
// of the object and changes its shape. The reads after each call must see the object as it is now.
const o = {
  a: 1,
  b: 2,
  c: 3,
  step(k) {
    if (k % 2 === 0) delete this.a;
    else this.a = k;
  },
};

let total = 0;
for (let i = 0; i < 30; i++) {
  total += o.b + o.c;
  o.step(i);
}
console.log(total, o.b, o.c, o.a);
